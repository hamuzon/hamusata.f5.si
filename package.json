
{
  "name": "hamusata.f5.si",
  "version": "2.0.0",
  "description": "hamusata の個人サイトです。 This is the personal website of hamusata.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamuzon/hamusata.f5.si.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hamuzon/hamusata.f5.si/issues"
  },
  "homepage": "https://github.com/hamuzon/hamusata.f5.si#readme",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "si.f5.hamusata",
    "productName": "hamusata",
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "files": [
      "electron/**/*",
      "**/*.html",
      "**/*.css",
      "**/*.js",
      "**/*.json",
      "**/*.webp",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.svg",
      "**/*.ico",
      "**/*.woff",
      "**/*.woff2",
      "**/*.ttf",
      "**/*.otf",
      "**/*.mp4",
      "**/*.webm",
      "**/*.mp3",
      "**/*.wav",
      "**/*.ogg",
      "!dist/**/*",
      "!.git/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "hamusata"
    },
    "publish": {
      "provider": "generic",
      "url": "https://app.hamusata.f5.si/setupfiles"
    }
  }
}
