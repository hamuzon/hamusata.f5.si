{
  "name": "hamusata.f5.si",
  "version": "1.0.0",
  "description": "hamusata の個人サイトです。  \r This is the personal website of hamusata.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamuzon/hamusata.f5.si.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hamuzon/hamusata.f5.si/issues"
  },
  "homepage": "https://github.com/hamuzon/hamusata.f5.si#readme",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "si.f5.hamusata",
    "productName": "hamusata",
    "artifactName": "hamusata_Setup-${version}.${ext}",
    "forceCodeSigning": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://app.hamusata.f5.si/setupfiles"
    }
  }
}
